# General
DISK_PATH=/your/mount/path
TZ=America/Lima

# Cloudflare Tunnel
CLOUDFLARE_TUNNEL_TOKEN=eyJhI...J9

# Pi-hole
PIHOLE_PASSWORD=awesomepassword
PIHOLE_DNS=1.1.1.1;1.0.0.1          # Upstream DNS servers (semicolon-separated)
PIHOLE_HOSTNAME=pihole.homelab       # Virtual host for Traefik routing
PIHOLE_THEME=default-dark

# Tailscale
TS_AUTHKEY=tskey-auth-abc...123

# SFTPGo
SFTPGO_ADMIN_USER=admin
SFTPGO_ADMIN_PASSWORD=awesomepassword

# Frigate - Tapo C220 (camera account created in the Tapo app)
FRIGATE_TAPO_USER=camerauser
FRIGATE_TAPO_PASSWORD=awesomepassword
FRIGATE_TAPO_IP=192.168.0.194

# door-watch - Telegram alerts
TELEGRAM_BOT_TOKEN=123456789:ABC...xyz
TELEGRAM_CHAT_ID=123456789
DOOR_ROI=100,50,200,300              # x,y,w,h of the door in the 640x360 detect frame
DOOR_THRESHOLD=0.15                  # score above this = door open (tune with "debug")
DOOR_OPEN_ALERT_S=600                # reminder while door stays open (0 = off)
CAT_COOLDOWN_S=300                   # min seconds between cat alerts
